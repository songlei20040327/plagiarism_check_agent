# Candidate retrieval only: these starting values require dev-set calibration.
# Use "dense" for the previous single-route baseline, "hybrid" for all routes.
RETRIEVAL_MODE=hybrid

# Each route recalls up to this many candidates; fusion keeps TOP_K_RESULTS.
RETRIEVAL_POOL_SIZE=20
TOP_K_RESULTS=5
RRF_RANK_CONSTANT=60

# This gate applies only to the dense route, never to BM25/literal candidates.
SIMILARITY_THRESHOLD=0.75

# Normalized character 5-gram containment for the literal recall route.
LITERAL_RECALL_THRESHOLD=0.35

# Prioritize strong 13-gram overlap within the final candidate budget.
# This never automatically labels plagiarism or changes the LLM judgment.
LITERAL_STRONG_THRESHOLD=0.95
