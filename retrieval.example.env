# Agreed pipeline: BM25 + dense -> union/dedup -> Cross-Encoder -> final top-K.
RETRIEVAL_MODE=hybrid_rerank
# At most 20 from each retriever; the entire union (at most 40) is reranked.
RETRIEVAL_POOL_SIZE=20
TOP_K_RESULTS=5

# Same embedding model is used for the reference corpus and thesis queries.
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# This recall gate is used ONLY by the dense comparison mode.
# hybrid and hybrid_rerank retain top-N dense candidates without this gate.
SIMILARITY_THRESHOLD=0.75

# Same Chinese/English Cross-Encoder as the Haystack official tutorial.
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_REVISION=2cfc18c9415c912f9d8155881c133215df768a70
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
# Joint token budget for each window pair; all text positions are covered.
RERANKER_MAX_LENGTH=512
# Long text pairs use overlapping windows, aggregated by the maximum relevance.
RERANKER_WINDOW_OVERLAP=32
# Provisional cutoff from the small development replay; validate on held-out papers.
# 2 is a raw logit, never a duplication probability.
RERANKER_PASS_THRESHOLD=2
AUTO_REVIEW_GATES=true
# Auto-pass also requires longest literal match <40 characters and query
# 13-character-gram coverage <0.15. Other pairs go to LLM review, except the
# versioned verbatim rule: >=120 consecutive characters, >=0.85 coverage,
# and no detected quotation/citation or standard-definition cues.
# These are development rules, not calibrated plagiarism probabilities.

# Comparison modes:
# RETRIEVAL_MODE=dense   : previous dense-only baseline
# RETRIEVAL_MODE=hybrid  : Haystack BM25+dense with RRF, no Cross-Encoder
